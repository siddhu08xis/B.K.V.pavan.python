budget = float(input("Enter travel budget in INR: "))
n = int(input("Enter number of expense categories: "))

expenses = []

for i in range(n):
    print("\nExpense", i + 1)

    category = input("Enter expense category: ")
    amount = float(input("Enter foreign currency amount: "))
    rate = float(input("Enter exchange rate in INR: "))

    conversion_fee = amount * rate * 0.02
    inr = amount * rate + conversion_fee

    expenses.append([category, inr])

    print("Expense in INR:", round(inr, 2))
    print("Conversion Fee:", round(conversion_fee, 2))

total = sum(item[1] for item in expenses)

largest = max(expenses, key=lambda x: x[1])

print("\nTRAVEL BUDGET REPORT")

for item in expenses:
    print(item[0], ":", round(item[1], 2))

print("Total Spending:", round(total, 2))
print("Budget:", budget)
print("Largest Expense:", largest[0])

if total > budget:
    print("Budget Exceeded")
else:
    print("Within Budget")

print("Remaining Budget:", round(budget - total, 2))
