bills = []

months = int(input("Enter number of months: "))

for i in range(months):
    units = float(input("Enter units consumed: "))

    if units <= 100:
        amount = units * 2
    elif units <= 200:
        amount = 100 * 2 + (units - 100) * 3
    elif units <= 300:
        amount = 100 * 2 + 100 * 3 + (units - 200) * 5
    else:
        amount = 100 * 2 + 100 * 3 + 100 * 5 + (units - 300) * 7

    fixed = 50
    surcharge = amount * 0.05
    rebate = 20 if units < 100 else 0

    total = amount + fixed + surcharge - rebate
    bills.append(total)

    print("Electricity Bill:", round(total, 2))

print("\nMONTHLY BILL COMPARISON")
for i in range(len(bills)):
    print("Month", i + 1, ":", round(bills[i], 2))

    if i > 0 and bills[i] > bills[i - 1] * 1.2:
        print("Unusual increase detected!")
