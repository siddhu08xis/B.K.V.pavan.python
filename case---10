venue = float(input("Enter venue cost: "))
equipment = float(input("Enter equipment cost: "))
catering = float(input("Enter catering cost per person: "))
transport = float(input("Enter transport cost: "))
certificate = float(input("Enter certificate cost per person: "))

participants = int(input("Enter expected participants: "))
fee = float(input("Enter registration fee per person: "))
sponsor = float(input("Enter sponsorship amount: "))

fixed_cost = venue + equipment + transport

variable_cost = participants * (catering + certificate)

total_cost = fixed_cost + variable_cost

registration_income = participants * fee

total_income = registration_income + sponsor

shortfall = total_cost - total_income

cost_per_person = catering + certificate

contribution_per_person = fee - cost_per_person

print("\nCAMPUS EVENT FINANCIAL REPORT")
print("Fixed Cost:", fixed_cost)
print("Variable Cost:", variable_cost)
print("Total Cost:", total_cost)
print("Registration Income:", registration_income)
print("Sponsorship:", sponsor)
print("Total Income:", total_income)

if shortfall > 0:
    print("Sponsorship Shortfall:", shortfall)
else:
    print("Surplus Amount:", abs(shortfall))

if contribution_per_person > 0:
    break_even = (fixed_cost - sponsor) / contribution_per_person

    if break_even < 0:
        break_even = 0

    print("Minimum Registrations to Break Even:", int(break_even) if break_even == int(break_even) else int(break_even) + 1)
else:
    print("Break-even is not possible with the given registration fee")
